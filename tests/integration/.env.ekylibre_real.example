# Configuration for the opt-in `pytest.mark.ekylibre_real` e2e test.
# Copy to `.env.ekylibre_real` (gitignored) and fill in real values.
# Run with: RUN_EKYLIBRE_E2E=1 uv run pytest -m ekylibre_real

# Ekylibre Rails URL.
# In dev with the default Apartment subdomain elevator, embed the tenant name
# as a subdomain on lvh.me so DNS resolves to 127.0.0.1.
EKYLIBRE_TEST_URL=http://closeriedesterres.lvh.me:3000

# Tenant label (also used as Postgres schema name and X-Tenant header value).
EKYLIBRE_TEST_TENANT=closeriedesterres

# A real user in that tenant + their `authentication_token`.
EKYLIBRE_TEST_USER_EMAIL=earlentredeuxterres@gmail.com
EKYLIBRE_TEST_USER_TOKEN=replace-with-real-token

# Postgres DSN for the read-only `duke_reader` role (provisioned via
# db/setup/duke_reader.sql + rake duke_reader:grant_tenants in the Ekylibre repo).
EKYLIBRE_TEST_DB_DSN=postgresql://duke_reader:duke_reader_dev@localhost:5431/eky_development
