# Duke service binding
DUKE_BIND=0.0.0.0:8000

# Ekylibre REST API (writes + token validation)
EKYLIBRE_API_BASE_URL=http://ekylibre:3000
EKYLIBRE_API_TIMEOUT_S=10

# Ekylibre Postgres (read-only account `duke_reader`, asyncpg DSN)
# REQUIRED
EKYLIBRE_DB_DSN=postgresql://duke_reader:duke_reader@db:5432/eky_development
EKYLIBRE_DB_POOL_MIN=2
EKYLIBRE_DB_POOL_MAX=20

# Duke Postgres (own DB for conversations + audit, SQLAlchemy async DSN)
# REQUIRED
DUKE_DB_DSN=postgresql+asyncpg://duke:duke@postgres-duke:5432/duke

# Logging
LOG_LEVEL=INFO
LOG_VERBOSE_PAYLOADS=false

# WS origin allow-list (comma-separated, empty = allow all in dev only)
ALLOWED_WS_ORIGINS=

# Run Alembic upgrade head at boot (dev convenience)
MIGRATE_ON_BOOT=false

# Session and rate limits
SESSION_IDLE_TIMEOUT_S=1800
RATE_LIMIT_PER_MIN=30

# LLM (one of "claude", "mistral", "ollama"). A provider is enabled only when
# its credentials/endpoint below are set; the user can switch between enabled
# providers from the widget. The default heads the fallback chain.
LLM_DEFAULT_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# Local LLM via Ollama (opt-in). Set OLLAMA_BASE_URL to enable the provider;
# bring the server up with `docker compose --profile local-llm up` (the
# ollama-pull sidecar fetches OLLAMA_MODEL on first start). Empty = disabled.
OLLAMA_BASE_URL=
# e.g. http://ollama:11434
OLLAMA_MODEL=mistral-nemo
LLM_MAX_TOKENS_OUT=1024
LLM_BUDGET_TOKENS_PER_SESSION=50000

# spaCy
SPACY_MODEL=fr_core_news_lg
# Path to a Duke-trained NER model (output of `python -m duke.cli.train_ner`).
# Empty = let the pipeline auto-detect the baked-in image path
# (/app/models/duke-ner) and fall back to SPACY_MODEL if it's not there.
# Set explicitly when running the dev process outside Docker, e.g.
# DUKE_NER_MODEL_PATH=/home/me/projects/duke/models/ner/duke-fr-v1
DUKE_NER_MODEL_PATH=

# Audit & RGPD
# REQUIRED in prod: a strong random secret used to hash tenant/email in the audit log.
HASH_SECRET=change-me-in-prod
RETENTION_DAYS_TURN_TEXT=90

# Server-side STT (Whisper) — opt-in fallback for browsers without working
# Web Speech API. Enabling this requires `uv sync --extra stt` (pulls
# faster-whisper + ctranslate2). The widget auto-detects via the Ekylibre
# DukeWidgetController `stt_server_enabled` flag.
ENABLE_SERVER_STT=false
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr
STT_MAX_AUDIO_BYTES=10485760
# Empty = use HuggingFace cache default (~/.cache/huggingface/hub).
WHISPER_CACHE_DIR=
